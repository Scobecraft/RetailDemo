# Mit "openssl rand -hex 24" zwei zufällige Werte erzeugen und hier eintragen.
# ADMIN_TOKEN: nur in der Admin-App eintragen (volle Kontrolle!)
ADMIN_TOKEN=bitte-aendern-admin
# DEVICE_TOKEN: in jeder Demo-App eintragen (darf nur Inhalte lesen)
DEVICE_TOKEN=bitte-aendern-geraet
# Optional: feste Zugangsdaten für die Webseite. Ohne diese Zeilen legst du Benutzer und Passwort
# beim ersten Aufruf der Webseite fest (mit dem ADMIN_TOKEN).
# WEB_USER=admin
# WEB_PASSWORD=ein-langes-sicheres-passwort
